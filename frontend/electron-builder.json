{
  "appId": "com.example.electron-fastapi-vue",
  "productName": "宠物样本检测",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/fastapi-backend.exe",
      "to": "fastapi-backend.exe"
    },
    {
      "from": "../backend/HBI.png",
      "to": "HBI.png"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "public/HBI.png"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "public/HBI.png"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "public/HBI.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}